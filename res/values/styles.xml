<resources>
  <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item>
    <item name="android:windowActionModeOverlay">true</item>
    <item name="android:windowFullscreen">true</item>
    <item name="android:colorAccent">@color/velira_accent</item>
    <item name="android:windowBackground">@color/velira_carbon</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:alertDialogTheme">@style/AuraDialog</item>
  </style>
  <style name="AuraDialog" parent="android:style/Theme.Material.Dialog.Alert">
    <item name="android:windowBackground">@drawable/aura_dialog</item>
    <item name="android:colorAccent">@color/velira_accent</item>
    <item name="android:textColorPrimary">@color/velira_ink</item>
    <item name="android:textColorSecondary">@color/velira_muted</item>
    <item name="android:colorBackgroundFloating">@color/velira_carbon</item>
  </style>
</resources>
